    "import re\n",
    "import queue\n",
    "from IPython.display import display, HTML, clear_output\n",
    "import ipywidgets as widgets\n",
    "\n",
    "# ─── Progress Milestones ───\n",
    "MILESTONES = [\n",
    "    (\"setup\", \"Setting up build environment\", 5),\n",
    "    (\"download_sdk\", \"Downloading Android SDK/NDK\", 15),\n",
    "    (\"extract_sdk\", \"Extracting SDK/NDK\", 20),\n",
    "    (\"download_python\", \"Downloading Python for Android\", 30),\n",
    "    (\"build_python\", \"Building Python interpreter\", 40),\n",
    "    (\"build_kivy\", \"Building Kivy & dependencies\", 55),\n",
    "    (\"build_app\", \"Compiling ARIA app code\", 70),\n",
    "    (\"package_apk\", \"Packaging APK\", 85),\n",
    "    (\"sign_apk\", \"Signing APK\", 90),\n",
    "    (\"complete\", \"Build complete!\", 100),\n",
    "]\n",
    "\n",
    "class ColabProgressMonitor:\n",
    "    def __init__(self):\n",
    "        self.current_milestone = 0\n",
    "        self.log_buffer = []\n",
    "        self.start_time = time.time()\n",
    "        self.last_output = \"\"\n",
    "        \n",
    "        # UI Elements\n",
    "        self.progress_bar = widgets.IntProgress(\n",
    "            value=0, min=0, max=100,\n",
    "            description='Progress:',\n",
    "            bar_style='info',\n",
    "            orientation='horizontal'\n",
    "        )\n",
    "        self.status_label = widgets.Label(value=\"Initializing...\")\n",
    "        self.time_label = widgets.Label(value=\"Elapsed: 0s\")\n",
    "        self.log_output = widgets.Output(layout={'height': '300px', 'overflow': 'auto'})\n",
    "        \n",
    "        self.ui = widgets.VBox([\n",
    "            widgets.HBox([self.progress_bar, self.time_label]),\n",
    "            self.status_label,\n",
    "            widgets.HTML(value=\"<hr>\"),\n",
    "            self.log_output\n",
    "        ])\n",
    "        display(self.ui)\n",
    "    \n",
    "    def update(self, milestone_idx: int, message: str = \"\"):\n",
    "        if milestone_idx < len(MILESTONES):\n",
    "            key, desc, pct = MILESTONES[milestone_idx]\n",
    "            self.current_milestone = milestone_idx\n",
    "            self.progress_bar.value = pct\n",
    "            self.status_label.value = f\"{desc} ({pct}%)\"\n",
    "            elapsed = int(time.time() - self.start_time)\n",
    "            self.time_label.value = f\"Elapsed: {elapsed//60}m {elapsed%60}s\"\n",
    "            if message:\n",
    "                self.log(message)\n",
    "    \n",
    "    def log(self, msg: str):\n",
    "        timestamp = datetime.now().strftime(\"%H:%M:%S\")\n",
    "        entry = f\"[{timestamp}] {msg}\"\n",
    "        self.log_buffer.append(entry)\n",
    "        if len(self.log_buffer) > 200:\n",
    "            self.log_buffer = self.log_buffer[-200:]\n",
    "        with self.log_output:\n",
    "            clear_output(wait=True)\n",
    "            print(\"\\n\".join(self.log_buffer[-50:]))\n",
    "    \n",
    "    def complete(self, success: bool = True):\n",
    "        self.progress_bar.value = 100\n",
    "        self.progress_bar.bar_style = 'success' if success else 'danger'\n",
    "        self.status_label.value = \"✅ BUILD COMPLETE!\" if success else \"❌ BUILD FAILED\"\n",
    "        elapsed = int(time.time() - self.start_time)\n",
    "        self.time_label.value = f\"Total: {elapsed//60}m {elapsed%60}s\"\n",
    "\n",
