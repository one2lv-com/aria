    "chat(BUILDER_ID, \"🔨 Launching buildozer android debug...\")\n",
    "LOBBY.add_artifact(\"build_started\")\n",
    "\n",
    "build_cmd = [\"buildozer\", \"-v\", \"android\", \"debug\"]\n",
    "\n",
    "proc = subprocess.Popen(\n",
    "    build_cmd,\n",
    "    cwd=PROJECT_DIR,\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.STDOUT,\n",
    "    text=True,\n",
    "    bufsize=1,\n",
    "    env={**os.environ, \"PYTHONUNBUFFERED\": \"1\"}\n",
    ")\n",
    "\n",
    "# Milestone detection patterns\n",
    "patterns = [\n",
    "    (0, [\"Checking configuration\", \"Check configuration\"]),\n",
    "    (1, [\"Downloading.*SDK\", \"Downloading.*NDK\", \"Fetching SDK\", \"Fetching NDK\"]),\n",
    "    (2, [\"Extracting.*SDK\", \"Extracting.*NDK\", \"Unpacking\"]),\n",
    "    (3, [\"Downloading.*python\", \"Downloading.*crystax\", \"python-for-android\"]),\n",
    "    (4, [\"Building python\", \"Compiling python\", \"python build\"]),\n",
    "    (5, [\"Building kivy\", \"Building sdl2\", \"Building pygame\", \"kivy build\"]),\n",
    "    (6, [\"Building app\", \"Packaging app\", \"Compiling.*main.py\", \"Copying.*assets\"]),\n",
    "    (7, [\"Packaging APK\", \"Building APK\", \"aapt\", \"apkbuilder\"]),\n",
    "    (8, [\"Signing\", \"jarsigner\", \"apksigner\"]),\n",
    "    (9, [\"successfully\", \"Build successful\", \"APK located\", \"\\.apk\"]),\n",
    "]\n",
    "\n",
    "detected = [False] * len(patterns)\n",
    "\n",
    "for line in proc.stdout:\n",
    "    line = line.rstrip()\n",
    "    monitor.log(line)\n",
    "    \n",
    "    # Check for milestones\n",
    "    for idx, pat_list in patterns:\n",
    "        if not detected[idx]:\n",
    "            for pat in pat_list:\n",
    "                if re.search(pat, line, re.IGNORECASE):\n",
    "                    detected[idx] = True\n",
    "                    monitor.update(idx, line[:100])\n",
    "                    LOBBY.add_artifact(f\"milestone_{MILESTONES[idx][0]}\")\n",
    "                    chat(BUILDER_ID, f\"📍 Milestone: {MILESTONES[idx][1]}\")\n",
    "                    break\n",
    "    \n    # Heartbeat every 30 seconds\n",
    "    if int(time.time() - monitor.start_time) % 30 == 0:\n",
    "        heartbeat(BUILDER_ID)\n",
    "\n",
    "proc.wait()\n",
    "\n",
    "if proc.returncode == 0:\n",
    "    monitor.complete(True)\n",
    "    chat(BUILDER_ID, \"🎉 BUILD SUCCESSFUL! APK generated.\")\n",
    "    phase(\"complete\", \"APK built successfully\")\n",
    "else:\n",
    "    monitor.complete(False)\n",
    "    log_error(f\"Buildozer exited with code {proc.returncode}\")\n",
    "    phase(\"failed\", f\"Exit code: {proc.returncode}\")"
   ]
