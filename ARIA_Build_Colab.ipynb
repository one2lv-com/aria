    "# ============================================================\n",
    "# CELL 2: CLONE / SYNC PROJECT FROM GITHUB\n",
    "# ============================================================\n",
    "\n",
    "phase(\"sync\", \"Cloning ARIA project from GitHub\")\n",
    "\n",
    "# ─── CONFIGURE THESE ───\n",
    "GITHUB_REPO = \"https://github.com/one2lv-com/aria.git\"  # ← CHANGE THIS\n",
    "BRANCH = \"main\"\n",
    "PROJECT_DIR = \"/content/aria-agent\"\n",
    "\n",
    "if not os.path.exists(PROJECT_DIR):\n",
    "    chat(BUILDER_ID, f\"Cloning from {GITHUB_REPO}...\")\n",
    "    result = subprocess.run([\"git\", \"clone\", \"-b\", BRANCH, GITHUB_REPO, PROJECT_DIR], \n",
    "                          capture_output=True, text=True)\n",
    "    if result.returncode != 0:\n",
    "        log_error(f\"Git clone failed: {result.stderr}\")\n",
    "        raise RuntimeError(\"Clone failed. Check GITHUB_REPO variable.\")\n",
    "    chat(BUILDER_ID, \"✅ Repository cloned successfully\")\n",
    "else:\n",
    "    chat(BUILDER_ID, \"Project exists, pulling latest...\")\n",
    "    subprocess.run([\"git\", \"pull\"], cwd=PROJECT_DIR)\n",
    "\n",
    "os.chdir(PROJECT_DIR)\n",
