    "# ============================================================\n",
    "# CELL 4: INSTALL SYSTEM DEPENDENCIES\n",
    "# ============================================================\n",
    "\n",
    "phase(\"deps\", \"Installing system packages (Java, Android SDK tools, etc.)\")\n",
    "\n",
    "# Update apt and install requirements\n",
    "chat(BUILDER_ID, \"📦 Installing system dependencies via apt...\")\n",
    "\n",
    "apt_packages = [\n",
    "    \"openjdk-17-jdk\",\n",
    "    \"git\",\n",
    "    \"zip\",\n",
    "    \"unzip\",\n",
    "    \"wget\",\n",
    "    \"curl\",\n",
    "    \"libncurses5\",\n",
    "    \"libstdc++6\",\n",
    "    \"zlib1g\",\n",
    "    \"python3-pip\",\n",
    "    \"python3-venv\"\n",
    "]\n",
    "\n",
    "subprocess.run([\"apt-get\", \"update\", \"-qq\"], check=True)\n",
    "result = subprocess.run([\"apt-get\", \"install\", \"-y\", \"-qq\"] + apt_packages, \n",
    "                       capture_output=True, text=True)\n",
    "if result.returncode != 0:\n",
    "    log_warning(f\"Some apt packages may have failed: {result.stderr[:500]}\")\n",
    "else:\n",
    "    chat(BUILDER_ID, \"✅ System dependencies installed\")\n",
    "\n",
    "# Set JAVA_HOME\n",
    "java_home = \"/usr/lib/jvm/java-17-openjdk-amd64\"\n",
    "if os.path.exists(java_home):\n",
    "    os.environ[\"JAVA_HOME\"] = java_home\n",
    "    chat(BUILDER_ID, f\"☕ JAVA_HOME set to {java_home}\")\n",
    "\n",
    "# Upgrade pip and install buildozer + cython\n",
    "chat(BUILDER_ID, \"🐍 Installing buildozer, cython==0.29.36...\")\n",
    "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--break-system-packages\",\n",
    "               \"--upgrade\", \"pip\"], check=True)\n",
    "subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"--break-system-packages\",\n",
    "               \"buildozer\", \"cython==0.29.36\"], check=True)\n",
    "chat(BUILDER_ID, \"✅ Python build tools ready\")"
   ]
