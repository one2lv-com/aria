    "# ============================================================\n",
    "# CELL 3: APPLY PATCHES (PEP 668 + ROOT BYPASS)\n",
    "# ============================================================\n",
    "\n",
    "phase(\"patching\", \"Applying Buildozer & python-for-android patches\")\n",
    "\n",
    "import site\n",
    "\n",
    "def find_buildozer_android_py() -> Optional[Path]:\n",
    "    \"\"\"Locate buildozer/targets/android.py in site-packages.\"\"\"\n",
    "    for p in site.getsitepackages():\n",
    "        candidate = Path(p) / \"buildozer\" / \"targets\" / \"android.py\"\n",
    "        if candidate.exists():\n",
    "            return candidate\n",
    "    return None\n",
    "\n",
    "def find_p4a_checkdeps() -> Optional[Path]:\n",
    "    for p in site.getsitepackages():\n",
    "        candidate = Path(p) / \"pythonforandroid\" / \"checkdependencies.py\"\n",
    "        if candidate.exists():\n",
    "            return candidate\n",
    "    return None\n",
    "\n",
    "def find_p4a_build() -> Optional[Path]:\n",
    "    for p in site.getsitepackages():\n",
    "        candidate = Path(p) / \"pythonforandroid\" / \"build.py\"\n",
    "        if candidate.exists():\n",
    "            return candidate\n",
    "    return None\n",
    "\n",
    "# ─── Patch 1: buildozer android.py --user → --break-system-packages ───\n",
    "android_py = find_buildozer_android_py()\n",
    "if android_py:\n",
    "    content = android_py.read_text()\n",
    "    if '\"--user\"' in content:\n",
    "        content = content.replace('\"--user\"', '\"--break-system-packages\"')\n",
    "        android_py.write_text(content)\n",
    "        LOBBY.add_patch(f\"buildozer: {android_py} (--user → --break-system-packages)\")\n",
    "        chat(BUILDER_ID, f\"✅ Patched buildozer: {android_py.name}\")\n",
    "    else:\n",
    "        chat(BUILDER_ID, f\"ℹ️  buildozer already patched or pattern not found\")\n",
    "else:\n",
    "    log_warning(\"Could not find buildozer/targets/android.py\")\n",
    "\n",
    "# ─── Patch 2: p4a checkdependencies.py - disable prerequisites ───\n",
    "checkdeps = find_p4a_checkdeps()\n",
    "if checkdeps:\n",
    "    content = checkdeps.read_text()\n",
    "    # Find check_and_install_default_prerequisites and make it return early\n",
    "    if \"def check_and_install_default_prerequisites\" in content:\n",
    "        lines = content.split(\"\\n\")\n",
    "        in_func = False\n",
    "        brace_count = 0\n",
    "        new_lines = []\n",
    "        for i, line in enumerate(lines):\n",
    "            if \"def check_and_install_default_prerequisites\" in line:\n",
    "                in_func = True\n",
    "                new_lines.append(line)\n",
    "                new_lines.append(\"    \" + line.lstrip()[:len(line) - len(line.lstrip())] + \"return  # SKIP: Colab handles deps\")\n",
    "                continue\n",
    "            if in_func:\n",
    "                if line.strip() == \"\":\n",
    "                    continue\n",
    "                if line.strip().startswith(\"def \") and i > 0:\n",
    "                    in_func = False\n",
    "                elif \"return\" in line and \"# SKIP\" in line:\n",
    "                    pass\n",
    "                else:\n",
    "                    continue\n",
    "            new_lines.append(line)\n",
    "        checkdeps.write_text(\"\\n\".join(new_lines))\n",
    "        LOBBY.add_patch(f\"p4a: {checkdeps} (disabled prerequisites)\")\n",
    "        chat(BUILDER_ID, f\"✅ Patched p4a checkdependencies: {checkdeps.name}\")\n",
    "else:\n",
    "    log_warning(\"Could not find pythonforandroid/checkdependencies.py\")\n",
    "\n",
    "# ─── Patch 3: p4a build.py - add --break-system-packages ───\n",
    "p4a_build = find_p4a_build()\n",
    "if p4a_build:\n",
    "    content = p4a_build.read_text()\n",
    "    # Ensure pip install commands use --break-system-packages\n",
    "    if '\"pip\", \"install\"' in content and \"--break-system-packages\" not in content:\n",
    "        content = content.replace('\"pip\", \"install\"', '\"pip\", \"install\", \"--break-system-packages\"')\n",
    "        p4a_build.write_text(content)\n",
    "        LOBBY.add_patch(f\"p4a: {p4a_build} (added --break-system-packages)\")\n",
    "        chat(BUILDER_ID, f\"✅ Patched p4a build.py: {p4a_build.name}\")\n",
    "    else:\n",
    "        chat(BUILDER_ID, f\"ℹ️  p4a build.py already has --break-system-packages\")\n",
    "else:\n",
    "    log_warning(\"Could not find pythonforandroid/build.py\")\n",
    "\n",
    "chat(BUILDER_ID, \"✅ All patches applied. Ready for build.\")"
   ]
