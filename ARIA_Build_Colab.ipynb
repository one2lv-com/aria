   "source": [
    "# 🚀 ARIA Android APK Builder - Google Colab Edition\n",
    "\n",
    "**Purpose:** Build the ARIA Kivy/Python Android APK using Google's free cloud compute.\n",
    "\n",
    "**Why Colab?** Bypasses local sandbox OOM kills, PEP 668 restrictions, and hardware limits.\n",
    "\n",
    "**Multi-Agent Ready:** Includes Build Lobby integration for AI-to-AI coordination during build."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📋 Prerequisites\n",
    "\n",
    "1. **GitHub Repo** (optional but recommended): Push your `/root/agent` code to a repo\n",
    "2. **Runtime**: Select **Runtime → Change runtime type → T4 GPU** (more RAM) or **High-RAM**\n",
    "3. **Time**: ~15-25 minutes for first build\n",
    "\n",
    "**Just hit `Runtime → Run all` and watch the progress bar!**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    }
   },
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# CELL 1: ENVIRONMENT SETUP & BUILD LOBBY INIT\n",
    "# ============================================================\n",
    "\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import time\n",
    "import uuid\n",
    "import threading\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "from datetime import datetime, timezone\n",
    "from typing import Dict, List, Optional\n",
    "from dataclasses import dataclass, asdict\n",
    "from enum import Enum\n",
    "\n",
    "# ─── Build Lobby System ───\n",
    "class AgentRole(Enum):\n",
    "    ORCHESTRATOR = \"orchestrator\"\n",
    "    BUILDER = \"builder\"\n",
    "    WATCHER = \"watcher\"\n",
    "    REVIEWER = \"reviewer\"\n",
    "\n",
    "class MessageType(Enum):\n",
    "    HANDOFF = \"handoff\"\n",
    "    STATUS = \"status\"\n",
    "    ERROR = \"error\"\n",
    "    WARNING = \"warning\"\n",
    "    CHAT = \"chat\"\n",
    "    COMMAND = \"command\"\n",
    "    ARTIFACT = \"artifact\"\n",
    "    HEARTBEAT = \"heartbeat\"\n",
    "    PHASE_CHANGE = \"phase_change\"\n",
    "\n",
    "@dataclass\n",
    "class Agent:\n",
    "    id: str\n",
    "    role: str\n",
    "    name: str\n",
    "    status: str = \"active\"\n",
    "    metadata: Dict = None\n",
    "    \n",
    "    def __post_init__(self):\n",
    "        if self.metadata is None:\n",
    "            self.metadata = {}\n",
    "\n",
    "@dataclass\n",
    "class LobbyMessage:\n",
    "    id: str\n",
    "    from_agent: str\n",
    "    to_agent: str\n",
    "    timestamp: str\n",
    "    type: str\n",
    "    content: str\n",
    "    metadata: Dict = None\n",
    "    \n",
    "    def __post_init__(self):\n",
    "        if self.metadata is None:\n",
    "            self.metadata = {}\n",
    "\n",
    "class BuildLobby:\n",
    "    def __init__(self, lobby_path: str = \"/content/build_lobby.json\"):\n",
    "        self.lobby_path = Path(lobby_path)\n",
    "        self._lock = threading.Lock()\n",
    "        self._ensure_lobby()\n",
    "    \n",
    "    def _ensure_lobby(self):\n",
    "        if not self.lobby_path.exists():\n",
    "            initial = {\n",
    "                \"lobby_id\": f\"aria-build-{uuid.uuid4().hex[:8]}\",\n",
    "                \"created\": datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\"),\n",
    "                \"participants\": [],\n",
    "                \"build_state\": {\n",
    "                    \"phase\": \"initializing\",\n",
    "                    \"last_successful_step\": \"none\",\n",
    "                    \"blockers\": [],\n",
    "                    \"patches_applied\": [],\n",
    "                    \"artifacts_cached\": []\n",
    "                },\n",
    "                \"messages\": [],\n",
    "                \"sync_protocol\": {\n",
    "                    \"heartbeat_interval_sec\": 30,\n",
    "                    \"state_file\": str(self.lobby_path)\n",
    "                }\n",
    "            }\n",
    "            self._write(initial)\n",
    "    \n",
    "    def _read(self) -> Dict:\n",
    "        with self._lock:\n",
    "            with open(self.lobby_path, 'r') as f:\n",
    "                return json.load(f)\n",
    "    \n",
    "    def _write(self, data: Dict):\n",
    "        with self._lock:\n",
    "            with open(self.lobby_path, 'w') as f:\n",
    "                json.dump(data, f, indent=2)\n",
    "    \n",
    "    def register_agent(self, agent: Agent):\n",
    "        data = self._read()\n",
    "        data[\"participants\"] = [p for p in data[\"participants\"] if p[\"id\"] != agent.id]\n",
    "        data[\"participants\"].append(asdict(agent))\n",
    "        self._write(data)\n",
    "    \n",
    "    def update_agent_status(self, agent_id: str, status: str):\n",
    "        data = self._read()\n",
    "        for p in data[\"participants\"]:\n",
    "            if p[\"id\"] == agent_id:\n",
    "                p[\"status\"] = status\n",
    "                break\n",
    "        self._write(data)\n",
    "    \n",
    "    def broadcast(self, from_agent: str, msg_type: MessageType, content: str, metadata: Dict = None):\n",
    "        msg = LobbyMessage(\n",
    "            id=uuid.uuid4().hex[:12],\n",
    "            from_agent=from_agent,\n",
    "            to_agent=\"all\",\n",
    "            timestamp=datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\"),\n",
    "            type=msg_type.value,\n",
    "            content=content,\n",
    "            metadata=metadata or {}\n",
    "        )\n",
    "        self.send_message(msg)\n",
    "    \n",
    "    def send_message(self, msg: LobbyMessage):\n",
    "        data = self._read()\n",
    "        data[\"messages\"].append(asdict(msg))\n",
    "        if len(data[\"messages\"]) > 500:\n",
    "            data[\"messages\"] = data[\"messages\"][-500:]\n",
    "        self._write(data)\n",
    "    \n",
    "    def update_build_state(self, **kwargs):\n",
    "        data = self._read()\n",
    "        data[\"build_state\"].update(kwargs)\n",
    "        self._write(data)\n",
    "    \n",
    "    def get_state(self) -> Dict:\n",
    "        return self._read()\n",
    "    \n",
    "    def add_blocker(self, blocker: str):\n",
    "        data = self._read()\n",
    "        if blocker not in data[\"build_state\"][\"blockers\"]:\n",
    "            data[\"build_state\"][\"blockers\"].append(blocker)\n",
    "        self._write(data)\n",
    "    \n",
    "    def remove_blocker(self, blocker: str):\n",
    "        data = self._read()\n",
    "        if blocker in data[\"build_state\"][\"blockers\"]:\n",
    "            data[\"build_state\"][\"blockers\"].remove(blocker)\n",
    "        self._write(data)\n",
    "    \n",
    "    def add_patch(self, patch: str):\n",
    "        data = self._read()\n",
    "        if patch not in data[\"build_state\"][\"patches_applied\"]:\n",
    "            data[\"build_state\"][\"patches_applied\"].append(patch)\n",
    "        self._write(data)\n",
    "    \n",
    "    def add_artifact(self, artifact: str):\n",
    "        data = self._read()\n",
    "        if artifact not in data[\"build_state\"][\"artifacts_cached\"]:\n",
    "            data[\"build_state\"][\"artifacts_cached\"].append(artifact)\n",
    "        self._write(data)\n",
    "\n",
    "# ─── Global Lobby & Helpers ───\n",
    "LOBBY = BuildLobby()\n",
    "\n",
    "def join(agent_id: str, role: str, name: str, metadata: Dict = None):\n",
    "    agent = Agent(id=agent_id, role=role, name=name, metadata=metadata or {})\n",
    "    LOBBY.register_agent(agent)\n",
    "    LOBBY.broadcast(agent_id, MessageType.CHAT, f\"{name} ({role}) joined\")\n",
    "    return LOBBY\n",
    "\n",
    "def phase(phase_name: str, details: str = \"\"):\n",
    "    LOBBY.update_build_state(phase=phase_name, last_successful_step=phase_name)\n",
    "    LOBBY.broadcast(\"system\", MessageType.PHASE_CHANGE, f\"Phase: {phase_name} - {details}\")\n",
    "    print(f\"\\n{'='*60}\\n🏗️  PHASE: {phase_name.upper()} - {details}\\n{'='*60}\")\n",
    "\n",
    "def log_error(error: str, agent_id: str = \"system\"):\n",
    "    LOBBY.add_blocker(error)\n",
    "    LOBBY.broadcast(agent_id, MessageType.ERROR, error)\n",
    "    print(f\"❌ ERROR: {error}\")\n",
    "\n",
    "def log_warning(warning: str, agent_id: str = \"system\"):\n",
    "    LOBBY.broadcast(agent_id, MessageType.WARNING, warning)\n",
    "    print(f\"⚠️  WARNING: {warning}\")\n",
    "\n",
    "def chat(from_agent: str, content: str):\n",
    "    LOBBY.broadcast(from_agent, MessageType.CHAT, content)\n",
    "    print(f\"💬 [{from_agent}]: {content}\")\n",
    "\n",
    "def heartbeat(agent_id: str):\n",
    "    LOBBY.update_agent_status(agent_id, \"active\")\n",
    "    LOBBY.broadcast(agent_id, MessageType.HEARTBEAT, f\"{agent_id} alive\")\n",
    "\n",
    "# ─── Register this Colab Builder ───\n",
    "BUILDER_ID = f\"colab-builder-{uuid.uuid4().hex[:6]}\"\n",
    "join(BUILDER_ID, AgentRole.BUILDER.value, \"Colab Cloud Builder\", {\n",
    "    \"runtime\": \"colab\",\n",
    "    \"gpu\": \"T4\" if \"COLAB_GPU\" in os.environ else \"CPU\",\n",
    "    \"ram_gb\": 12.7\n",
    "})\n",
    "\n",
    "chat(BUILDER_ID, \"🚀 Colab builder online. Starting ARIA APK build...\")\n",
    "\n",
    "# Print lobby state\n",
    "print(json.dumps(LOBBY.get_state(), indent=2))"
   ]
  },
